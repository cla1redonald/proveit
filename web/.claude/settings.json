{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)/web\" && npx tsc --noEmit 2>&1 | head -20 || true",
            "description": "TypeScript check after file write (advisory)"
          }
        ]
      }
    ]
  }
}
